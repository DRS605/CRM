# Copiar a `.env` y rellenar. **No hay valores por defecto para los secretos** a propósito: un
# despliegue que arranca con la contraseña de ejemplo es un despliegue con la contraseña de ejemplo.
# Compose se niega a levantar si falta alguno de los obligatorios.

# El dominio donde vive esto. De aquí salen el certificado y el emisor de los tokens.
MK_DOMINIO=crm.tuempresa.es
MK_CORREO_TLS=avisos@tuempresa.es

# Base de datos. El dueño aplica las migraciones; la aplicación se conecta con `matchketing_app`, que
# se crea sola con la clave de abajo y **no es superusuario**.
MK_BD_NOMBRE=matchketing
MK_BD_DUENO=matchketing_dueno
MK_BD_CLAVE_DUENO=
MK_BD_CLAVE_APP=

# Firma de los tokens de sesión. 32 caracteres o más; cambiarla invalida todas las sesiones abiertas.
#   openssl rand -base64 48
MK_JWT_CLAVE=

# Correo saliente. Sin esto, los correos y las campañas se quedan en la cola y se avisa por registro:
# la aplicación arranca igual, pero no manda nada.
MK_SMTP_SERVIDOR=
MK_SMTP_PUERTO=587
MK_SMTP_USUARIO=
MK_SMTP_CLAVE=
MK_SMTP_REMITENTE=
MK_SMTP_NOMBRE=match.keting
MK_SMTP_SSL=true

# Avisos push del repaso de los viernes. Se generan una vez y no se cambian: cambiarlas obliga a que
# todo el mundo vuelva a dar permiso en su móvil.
MK_VAPID_PUBLICA=
MK_VAPID_PRIVADA=
MK_VAPID_CONTACTO=mailto:avisos@tuempresa.es
